/target
**/*.rs.bk
Cargo.lock.bak

# Dados locais e bases de desenvolvimento
/dados/*.db
/dados/*.db-wal
/dados/*.db-shm
/dados/backup/
/dados/analytics/
/dados/logs/

# Segredos e certificados
/certificados/
*.pfx
*.p12
*.pem
*.key
cardeal.toml
.env

# Medições e artefatos temporários
/docs/medicoes/*.tmp
/fuzz/artifacts/
/fuzz/corpus/

# Editores
.vscode/
.idea/
*.swp
.DS_Store

# Worktrees de agentes (Claude Code) — repositórios git próprios, nunca devem virar gitlink
# dentro deste repo (aconteceu por acidente com um `git add -A` sem essa regra).
.claude/worktrees/
